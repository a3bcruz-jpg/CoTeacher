generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TeacherTitle {
  SIR
  MAAM
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentStatus {
  DRAFT
  FINAL
  ARCHIVED
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
}

enum FileStatus {
  ACTIVE
  DELETED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  lastLoginAt        DateTime?
  teacherProfile     TeacherProfile?
  tasks              Task[]
  documents          Document[]
  aiGenerations      AIGeneration[]
  files              StoredFile[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  subscription       Subscription?
  documentVersions   DocumentVersion[]
}

model School {
  id          String          @id @default(cuid())
  name        String
  district    String?
  division    String?
  region      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  teachers    TeacherProfile[]
  classes     Class[]
}

model TeacherProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  schoolId       String?
  title          TeacherTitle?
  fullName       String
  position       String?
  gradeLevel     String?
  department     String?
  schoolYear     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school         School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  classes        Class[]  @relation("TeacherClasses")
}

model Class {
  id          String         @id @default(cuid())
  schoolId    String?
  teacherId   String?
  name        String
  gradeLevel  String?
  schoolYear  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  school      School?        @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  teacher     TeacherProfile? @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: SetNull)
  subjects    Subject[]

  @@index([teacherId])
  @@index([schoolId])
}

model Subject {
  id          String   @id @default(cuid())
  classId     String
  name        String
  gradeLevel  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  dueAt       DateTime?
  priority    TaskPriority  @default(MEDIUM)
  status      TaskStatus    @default(TODO)
  category    String?
  recurring   Boolean      @default(false)
  recurrence  String?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueAt])
}

model DocumentTemplate {
  id          String         @id @default(cuid())
  name        String
  description String?
  category    String?
  version     Int            @default(1)
  status      TemplateStatus @default(ACTIVE)
  schema      Json
  instructions String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  documents   Document[]

  @@index([status, category])
}

model Document {
  id            String          @id @default(cuid())
  userId        String
  templateId    String?
  title         String
  content       String?
  status        DocumentStatus  @default(DRAFT)
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  versions      DocumentVersion[]
  files         StoredFile[]
  aiGenerations AIGeneration[]

  @@index([userId, status])
  @@index([userId, updatedAt])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  version    Int
  content    String?
  metadata   Json?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

model AIGeneration {
  id          String    @id @default(cuid())
  userId      String
  documentId  String?
  feature     String
  model       String?
  inputHash   String?
  promptMeta  Json?
  outputText  String?
  tokensUsed  Int?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([documentId])
}

model StoredFile {
  id           String      @id @default(cuid())
  userId       String
  documentId   String?
  storageKey   String      @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt
  status       FileStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([documentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  resourceId String?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resource, resourceId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  status               SubscriptionStatus  @default(TRIALING)
  plan                 String             @default("FREE")
  provider              String?
  providerCustomerId   String?
  providerSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, plan])
}
